{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-translate.invalid/schemas/phase7-blind-eval-private-answer-key-v1.json",
  "title": "Phase 7 private blind-evaluation answer key",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "scope",
    "randomizationSeed",
    "randomizationCommitment",
    "inputSha256",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase7-blind-eval-private-answer-key-v1"
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "scope": {
      "const": "POC_RESEARCH_ONLY_NO_INTEGRATION_OR_DISTRIBUTION"
    },
    "randomizationSeed": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "randomizationCommitment": {
      "$ref": "#/$defs/sha256"
    },
    "inputSha256": {
      "$ref": "#/$defs/sha256"
    },
    "records": {
      "type": "array",
      "minItems": 400,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{16}$"
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemToken",
        "itemId",
        "direction",
        "sourceSha256",
        "referenceSha256",
        "candidates"
      ],
      "properties": {
        "itemToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "itemId": {
          "$ref": "#/$defs/slug"
        },
        "direction": {
          "enum": [
            "en-zh",
            "zh-en"
          ]
        },
        "sourceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "referenceSha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/candidate"
          }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "candidateAlias",
        "candidateId",
        "generationRunId",
        "translationSha256"
      ],
      "properties": {
        "evaluationId": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "candidateAlias": {
          "type": "string",
          "pattern": "^[A-Z]$"
        },
        "candidateId": {
          "$ref": "#/$defs/slug"
        },
        "generationRunId": {
          "$ref": "#/$defs/slug"
        },
        "translationSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
