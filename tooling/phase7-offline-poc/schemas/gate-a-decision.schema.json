{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-translate.invalid/schemas/phase7-gate-a-decision-v1.json",
  "title": "Phase 7 Gate A user route decision",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "decisionId",
    "decidedAt",
    "decisionAuthority",
    "decisionBasis",
    "confirmationSummary",
    "m4Completion",
    "selection",
    "selectionSha256",
    "acceptedLimitations",
    "authorization"
  ],
  "properties": {
    "schemaVersion": { "const": "phase7-gate-a-decision-v1" },
    "status": { "const": "GATE_A_CONFIRMED" },
    "decisionId": {
      "type": "string",
      "pattern": "^gate-a-decision-[a-f0-9]{16}$"
    },
    "decidedAt": { "type": "string", "format": "date-time" },
    "decisionAuthority": { "const": "USER" },
    "decisionBasis": {
      "const": "EXPLICIT_USER_CONFIRMATION_IN_CODEX"
    },
    "confirmationSummary": { "type": "string", "minLength": 1 },
    "m4Completion": { "type": "object" },
    "selection": { "type": "object" },
    "selectionSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptedLimitations": { "type": "object" },
    "authorization": { "type": "object" }
  }
}
