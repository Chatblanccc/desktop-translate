{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-translate.invalid/schemas/phase7-argos-blind-eval-candidate-output-v1.json",
  "title": "Phase 7 Argos private blind-evaluation candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "itemId",
    "direction",
    "candidateId",
    "generationRunId",
    "sourceSha256",
    "translation"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase7-argos-blind-eval-candidate-output-v1"
    },
    "itemId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "direction": {
      "enum": [
        "en-zh",
        "zh-en"
      ]
    },
    "candidateId": {
      "enum": [
        "argos-opus-en-zh-1.9",
        "argos-opus-zh-en-1.9"
      ]
    },
    "generationRunId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "translation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24000
    }
  }
}
