{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-translate.invalid/schemas/phase7-m4-ai-completion-v1.json",
  "title": "Phase 7 M4 AI completion and risk approval",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "approvalId",
    "approvedAt",
    "scope",
    "delegation",
    "assessor",
    "primaryEvidence",
    "primaryEvidenceSetSha256",
    "candidateGenerationBindings",
    "qualityApproval",
    "legalApproval",
    "networkApproval",
    "packageSizingApproval",
    "decision",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "phase7-m4-ai-completion-v1" },
    "status": {
      "const": "M4_AI_APPROVED_COMPLETE_FOR_GATE_A_SUBMISSION"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^m4-ai-approval-[a-f0-9]{16}$"
    },
    "approvedAt": { "type": "string", "format": "date-time" },
    "scope": {
      "const": "POC_RESEARCH_ONLY_NO_INTEGRATION_OR_DISTRIBUTION"
    },
    "delegation": { "type": "object" },
    "assessor": { "type": "object" },
    "primaryEvidence": { "type": "object" },
    "primaryEvidenceSetSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateGenerationBindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "qualityApproval": { "type": "object" },
    "legalApproval": { "type": "object" },
    "networkApproval": { "type": "object" },
    "packageSizingApproval": { "type": "object" },
    "decision": {
      "type": "object",
      "required": [
        "m4Complete",
        "gateAInputReady",
        "gateADecisionStatus",
        "integrationOrDistributionAuthorized",
        "m5Authorized"
      ],
      "properties": {
        "m4Complete": { "const": true },
        "gateAInputReady": { "const": true },
        "gateADecisionStatus": {
          "const": "AWAITING_EXPLICIT_USER_DECISION"
        },
        "integrationOrDistributionAuthorized": { "const": false },
        "m5Authorized": { "const": false }
      }
    },
    "privacy": { "type": "object" }
  }
}
