{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desktop-translate.invalid/schemas/phase7-offline-poc-authorization-v1.json",
  "title": "Desktop Translate Phase 7 M0 POC research authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorization",
    "scope",
    "basis",
    "manifestSha256",
    "candidateIds",
    "observedLicenseMetadataExpressions",
    "acknowledgedRiskCodes",
    "authorizationRecordId",
    "authorizedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "phase7-offline-poc-authorization-v1"
    },
    "authorization": {
      "enum": [
        "PENDING",
        "AUTHORIZED_FOR_POC_RESEARCH_ONLY",
        "REVOKED"
      ]
    },
    "scope": {
      "const": "POC_RESEARCH_ONLY_NO_INTEGRATION_OR_DISTRIBUTION"
    },
    "basis": {
      "const": "PHASE7_M0_USER_AUTHORIZATION"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observedLicenseMetadataExpressions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acknowledgedRiskCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "authorizationRecordId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "authorizedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
