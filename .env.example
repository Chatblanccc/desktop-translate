# Development only. Never commit provider credentials.
# The app does not load .env files automatically. Export these values in the
# launching PowerShell process when overriding defaults.
SELECTION_HOST_PATH=
DESKTOP_TRANSLATE_LOG_LEVEL=info

# Phase 4 validation only. When set to an absolute local JSONL file, Main writes
# derived request metadata only; it never writes field values, text, credentials,
# salt, signatures, responses, or bodies. Leave empty for normal use.
DESKTOP_TRANSLATE_PHASE4_AUDIT_FILE=
