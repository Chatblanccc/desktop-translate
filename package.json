{
  "name": "desktop-translate",
  "version": "0.2.0-phase2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.23.1 <25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @desktop-translate/desktop test:coverage",
    "test:e2e": "pnpm --filter @desktop-translate/desktop test:e2e",
    "test:contracts": "pnpm --filter @desktop-translate/contracts test",
    "test:desktop": "pnpm --filter @desktop-translate/desktop test",
    "phase1:smoke": "pnpm --filter @desktop-translate/desktop phase1:smoke",
    "phase1:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/phase1-verify.ps1",
    "phase2:smoke": "pnpm --filter @desktop-translate/desktop phase2:smoke",
    "phase2:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/phase2-verify.ps1",
    "start:phase2": "pnpm --filter @desktop-translate/desktop start:phase2",
    "native:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/native-phase1.ps1 -Action Configure",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/native-phase1.ps1 -Action Build",
    "native:test": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tooling/native-phase1.ps1 -Action Test"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "electron": "^43.1.1",
    "oxlint": "^1.74.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
