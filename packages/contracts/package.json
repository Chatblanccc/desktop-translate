{
  "name": "@desktop-translate/contracts",
  "version": "0.5.0-phase5",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --experimental-sqlite --test ../../tests/contracts/*.test.ts ../../tests/contracts/*.test.mjs",
    "test:coverage": "node --import tsx --test --experimental-sqlite --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=75 ../../tests/contracts/*.test.ts ../../tests/contracts/*.test.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./native-ipc": "./src/native-ipc.ts",
    "./selection-card": "./src/selection-card.ts",
    "./translation": "./src/translation.ts",
    "./ui-shell": "./src/ui-shell.ts"
  }
}
