#include <winuser.h>
#include <winver.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@DT_SELECTION_HOST_MANIFEST@"

1 VERSIONINFO
 FILEVERSION @DT_FILE_VERSION_COMMA@
 PRODUCTVERSION @DT_FILE_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Desktop Translate\0"
      VALUE "FileDescription", "Desktop Translate Selection Host\0"
      VALUE "FileVersion", "@DT_FILE_VERSION@\0"
      VALUE "InternalName", "selection-host\0"
      VALUE "LegalCopyright", "Copyright (c) Desktop Translate contributors\0"
      VALUE "OriginalFilename", "selection-host.exe\0"
      VALUE "ProductName", "Desktop Translate\0"
      VALUE "ProductVersion", "@DT_PRODUCT_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
