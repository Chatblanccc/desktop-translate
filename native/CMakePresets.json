{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "DT_NATIVE_BUILD_TESTS": "ON",
        "DT_NATIVE_ENABLE_PADDLE_OCR": "OFF"
      }
    },
    {
      "name": "portable-core-debug",
      "displayName": "Portable core tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/portable-core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DT_NATIVE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-debug",
      "configuration": "Release"
    },
    {
      "name": "portable-core-debug",
      "configurePreset": "portable-core-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "portable-core-debug",
      "configurePreset": "portable-core-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
